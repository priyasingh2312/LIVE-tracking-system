# Copy this file to .env (never commit .env). The IP camera address goes here.
# If the password contains special characters, URL-encode them (for example @ becomes %40).
#
# Hikvision-style:  rtsp://user:password@192.168.1.10:554/Streaming/Channels/101   (main stream; 102 = sub stream)
# Dahua / CP Plus:  rtsp://user:password@192.168.1.10:554/cam/realmonitor?channel=1&subtype=0   (subtype=1 = sub stream)
# Other brands: look for "RTSP URL" in the camera's manual or use ONVIF Device Manager to find it.
RTSP_URL=rtsp://webskitters:ws%4012345@10.215.184.80:554/stream1
